// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  GROUP
  DIRECT
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String     @unique
  password  String
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  roles     UserRole[] @default([USER])

  verificationToken String
  verificationTokenExpiresAt DateTime

  messages             Message[]
  groupMemberships     GroupMember[]
  createdGroups        GroupConversation[]  @relation("GroupCreator")
  directConversationsA DirectConversation[] @relation("UserADirect")
  directConversationsB DirectConversation[] @relation("UserBDirect")
  // verificationTokens   VerificationToken[]
  // passwordResetTokens  PasswordResetToken[]
}

// model PasswordResetToken {
//   id        String   @id @default(uuid())
//   token     String
//   userId    String
//   expiresAt DateTime

//   user User @relation(fields: [userId], references: [id])
// }

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  createdAt DateTime         @default(now())

  messages Message[]
  group    GroupConversation?
  direct   DirectConversation?
}

model GroupConversation {
  id             String  @id @default(uuid())
  conversationId String  @unique
  name           String
  creatorId      String
  avatarUrl      String?

  conversation Conversation  @relation(fields: [conversationId], references: [id])
  creator      User          @relation("GroupCreator", fields: [creatorId], references: [id])
  members      GroupMember[]
}

model GroupMember {
  groupConversationId String
  userId              String
  role                GroupRole @default(MEMBER)
  joinedAt            DateTime  @default(now())

  groupConversation GroupConversation @relation(fields: [groupConversationId], references: [id])
  user              User              @relation(fields: [userId], references: [id])

  @@id([groupConversationId, userId])
}

model DirectConversation {
  id             String @id @default(uuid())
  conversationId String @unique
  userAId        String
  userBId        String

  conversation Conversation @relation(fields: [conversationId], references: [id])
  userA        User         @relation("UserADirect", fields: [userAId], references: [id])
  userB        User         @relation("UserBDirect", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Message {
  id             String   @id @default(uuid())
  content        String
  createdAt      DateTime @default(now())
  senderId       String
  conversationId String

  sender       User         @relation(fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
}
